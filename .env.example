# Copie para .env e preencha. NUNCA commite o .env.

# Ambiente ativo: escolhe o bloco environments dos YAMLs E o perfil de banco
# dev = execução local | prod = Airflow
ENV=dev

# Raiz do data lake local (landing/bronze) e dos seeds do dbt (repo the_dw)
LAKE_ROOT=/media/lucas/Files/2.Projetos/0.mylake
SEEDS_ROOT=/home/lucas/workspace/the_dw/seeds

# Postgres (destino raw_<fonte>.*) — um perfil por ambiente: DB__<ENV>__<CAMPO>
# dev: obrigatoriamente analytics_dev (settings.py valida)
DB__DEV__HOST=localhost
DB__DEV__PORT=5435
DB__DEV__NAME=analytics_dev
DB__DEV__USER=
DB__DEV__PASSWORD=
# prod: banco de produção (Airflow) em outro host. Pode ficar vazio quando ENV=dev.
DB__PROD__HOST=
DB__PROD__PORT=5432
DB__PROD__NAME=
DB__PROD__USER=
DB__PROD__PASSWORD=

# dbt (usado só pelo repo demodadosdw, mantido aqui por conveniência)
DBT_USER=
DBT_PASSWORD=

# Pipeline energia/solar — portal apsystemsema.com
APSYSTEMS_USER=
APSYSTEMS_PASSWORD=

# Pipeline financas/investimentos (google) — service account (arquivo FORA do repo)
GOOGLE_CREDENTIALS_FILE=~/.secrets/finances-py-a58b0d2a733f.json
# URLs das planilhas: uma por chave de options.sheets do investimentos_config.yml
# (settings.url_finance[<chave>]; delimitador duplo __)
URL_FINANCE__LUCAS_JESSICA=
URL_FINANCE__DEUSA=

# Pipeline clima/openweather — chave da API One Call 3.0 (era MY_API no repo antigo)
OPENWEATHER_API_KEY=

# Selenium remoto para solar e fundos_imobiliarios (vazio = Chrome local).
# No Airflow: http://host.docker.internal:4444/wd/hub (dev) ou http://selenium:4444/wd/hub (prod)
SELENIUM_REMOTE_URL=

# Pluggy (não utilizado no momento)
CLIENT_ID=
CLIENT_SECRET=
